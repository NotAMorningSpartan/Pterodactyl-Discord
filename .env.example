# Discord bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=

# ID of the Discord guild (server) the bot operates in. Enable Developer
# Mode in Discord to copy IDs via right-click.
DISCORD_GUILD_ID=

# ID of the Discord role permitted to control server power state.
ALLOWED_ROLE_ID=

# Base URL of the Pterodactyl panel, no trailing slash (e.g. https://panel.example.com).
PTERODACTYL_URL=

# Pterodactyl Application API key (Admin > Application API), used for
# account/server lookups that require admin-level access.
PTERODACTYL_APP_API_KEY=

# Pterodactyl Client API key (Account > API Credentials), used for
# per-server actions such as power control on behalf of a user.
PTERODACTYL_CLIENT_API_KEY=

# Set to true to disable TLS certificate verification on requests to
# PTERODACTYL_URL (e.g. a self-signed or internal-CA panel cert).
# Insecure: the Authorization header becomes interceptable. Only use as a
# stopgap on a trusted network; fixing the panel's certificate is the real
# fix. Defaults to false.
PTERODACTYL_SKIP_SSL_VERIFY=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
LOG_LEVEL=INFO
